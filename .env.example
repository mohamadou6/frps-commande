# Copier ce fichier en .env et adapter les valeurs.

DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Stock (Sage Gescom via SQL Server) ---
# STOCK_CONNECTOR_BACKEND: mock (par défaut, données d'exemple) | sage_sql_server (réel)
STOCK_CONNECTOR_BACKEND=mock
SQLSERVER_HOST=
SQLSERVER_DB=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# --- SMS ---
# SMS_BACKEND: log (par défaut, journalise seulement) | twilio (réel via Twilio) | orange (Orange Developer, meilleure délivrabilité CM) | real (passerelle SMS locale)
SMS_BACKEND=log
SMS_API_URL=
SMS_API_KEY=

# --- Orange Developer SMS API (voir developer.orange.com) ---
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Numéro/short code expéditeur approuvé par Orange, format ex: tel:+237XXXXXXXXX
ORANGE_SMS_SENDER_ADDRESS=
# Nom d'expéditeur affiché (optionnel, ex: "SMS 844926" par défaut ou un sender name
# personnalisé une fois validé par l'équipe marketing locale Orange)
ORANGE_SMS_SENDER_NAME=

# --- Paiement ---
# PAYMENT_GATEWAY: mock (par défaut, confirme automatiquement) | orange_money (réel)
PAYMENT_GATEWAY=mock
ORANGE_MONEY_API_URL=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COMPTE_FRPS=+237 6XX XXX XXX (FRPS - à confirmer)

# --- WhatsApp (envoi du PDF de commande validée) ---
# WHATSAPP_BACKEND: log (par défaut, journalise seulement) | twilio (réel via Twilio) | real (squelette Meta Cloud API)
WHATSAPP_BACKEND=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# 5 numéros séparés par des virgules (format international, ex: +237...)
WHATSAPP_NOTIFICATION_NUMBERS=+237600000010,+237600000011,+237600000012,+237600000013,+237600000014

# URL publique HTTPS du serveur (ex: tunnel ngrok en dev : https://xxxx.ngrok-free.app)
# Nécessaire pour Twilio, qui télécharge le PDF via cette URL - ne fonctionne pas avec localhost.
PUBLIC_BASE_URL=http://localhost:8000

# --- Twilio (voir console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro sandbox par défaut ; remplacer par ton numéro WhatsApp Twilio approuvé en prod
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Numéro Twilio acheté (capacité SMS), utilisé par TwilioSMSBackend
TWILIO_SMS_FROM=
