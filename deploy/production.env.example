# Copier ce fichier en .env sur le serveur de production (à côté de manage.py) et adapter.

DEBUG=False
SECRET_KEY=CHANGER-CETTE-CLE-EN-PRODUCTION-genere-en-une-nouvelle
ALLOWED_HOSTS=frpsno.com,www.frpsno.com

# PostgreSQL (remplace SQLite en production) - adapter selon l'installation locale
DATABASE_URL=postgres://frps_user:CHANGER-MOT-DE-PASSE@localhost:5432/frps_commande

# --- Stock (Sage Gescom via SQL Server) ---
# Le serveur applicatif tourne sur le même réseau local que le SQL Server FRPS :
# connexion directe, pas besoin de VPN.
# SQLSERVER_USER/PASSWORD : utiliser le compte en LECTURE SEULE créé via
# deploy/sql/create_readonly_user.sql (frps_commande_readonly) - jamais un compte
# avec des droits d'écriture sur la base Sage.
STOCK_CONNECTOR_BACKEND=sage_sql_server
SQLSERVER_HOST=nom-ou-ip-du-serveur-sql
SQLSERVER_DB=nom_base_sage
SQLSERVER_USER=frps_commande_readonly
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# --- SMS (Twilio, déjà configuré et fonctionnel) ---
SMS_BACKEND=twilio

ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=

# --- Paiement ---
PAYMENT_GATEWAY=mock
ORANGE_MONEY_API_URL=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COMPTE_FRPS=+237 6XX XXX XXX (FRPS - à confirmer)

# --- WhatsApp (désactivé, PDF partagé manuellement par la FOSA) ---
WHATSAPP_BACKEND=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_NOTIFICATION_NUMBERS=

# URL publique du domaine (via le tunnel Cloudflare)
PUBLIC_BASE_URL=https://frpsno.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
